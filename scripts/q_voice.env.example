# Voice assistant (SUPER+T) — per-device settings, loaded by scripts/q_voice.sh.
# Copy to ~/.config/q-voice/env (outside the repo; `q_voice.sh setup` does
# it) and fill in. Only the first two are required.

# openclaw gateway (chat completions endpoint and its bearer token)
Q_GATEWAY_URL=http://overlord-1:18789   # the desktop, over Tailscale (http://127.0.0.1:18789 on the desktop itself)
Q_GATEWAY_TOKEN=

# Identity: notification/log name, and how this machine introduces itself
#Q_NAME=Q
#Q_DEVICE=my-desktop           # default: hostname
#Q_DEVICE_NOTE=                # one line of context for the agent, e.g. "desk machine in my room, headset mic"
#Q_AGENT=main                  # gateway agent id
#Q_MODEL=                      # e.g. anthropic/claude-sonnet-5; empty = gateway default
#Q_BRIEF=1                     # ask for short spoken replies

# Speech to text: ElevenLabs Scribe when a key is set (Q_STT=auto), else/fallback the local
# whisper-server (whisper.cpp). Q_STT=whisper keeps your audio on this machine.
#Q_STT=auto                    # auto | elevenlabs | whisper
#Q_ELEVENLABS_STT_MODEL=scribe_v2
#Q_WHISPER_URL=http://127.0.0.1:8178/inference
#Q_WHISPER_MODEL=~/.local/share/whisper/ggml-base.en.bin

# Who is talking: q-speaker /identify (may be on another host; profiles are shared with it).
# Empty = no speaker id. `q_voice.py enroll <name>` teaches it the last clip from this mic.
#Q_SPEAKER_URL=http://speaker-host:8179/identify
#Q_KEEP_CLIPS=40               # turns of audio kept for enrollment
#Q_SPEAKERS=~/.config/q-voice/speakers.json  # who the profiles are (names stay out of the repo), e.g.
#   {"owner": "alex", "household": ["alex", "sam"], "people": {"alex": "Alex", "sam": "Sam, Alex's roommate"}}

# Text to speech: auto tries elevenlabs, then the gateway relay, then piper
#Q_TTS=auto                    # auto | elevenlabs | gateway | piper
#Q_ELEVENLABS_API_KEY=
#Q_ELEVENLABS_VOICE=N2lVS1w4EtoT3dr4eOWO  # Callum, the Q voice (default)
#Q_ELEVENLABS_MODEL=eleven_v3  # default; stability 0.5
#Q_GATEWAY_SSH=                # ssh host that runs openclaw, for `gateway call tts.speak`
#Q_GATEWAY_CLI=openclaw        # openclaw binary on that host
#Q_PIPER_BIN=~/.local/bin/piper
#Q_PIPER_VOICE=~/.local/share/piper/en_US-lessac-medium.onnx

# Listening
#Q_CONVERSE=1                  # keep listening for a follow-up after each reply
#Q_CONVERSE_TIMEOUT_S=8
#Q_VAD_SILENCE_MS=700          # trailing silence that ends your turn
#Q_VAD_START_TIMEOUT_S=20
#Q_MAX_RECORD_S=45
#Q_PAUSE_MEDIA=1               # pause playerctl media while a turn is in flight
#Q_MUTE=0
#Q_DEBUG=0
